{
  "name": "job-curator",
  "version": "1.0.0",
  "description": "High-performance dynamic job curator CLI with multi-board scraping, Google Gemini AI structured evaluation, candidate persona extraction, and localhost Web UI.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "job-curator": "./dist/cli.js"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "dev": "tsx watch src/cli.ts",
    "build": "tsup src/cli.ts src/index.ts --format esm --clean && cp -r src/server/public dist/public",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "job-curator",
    "scraper",
    "cheerio",
    "playwright",
    "gemini",
    "google-genai",
    "structured-outputs",
    "resume-parser",
    "web3-jobs",
    "foorilla",
    "cryptojobslist"
  ],
  "author": "Antigravity Open Source",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@inquirer/prompts": "^8.7.1",
    "chalk": "^5.4.1",
    "cheerio": "^1.0.0",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "open": "^10.1.0",
    "ora": "^8.2.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.50.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/pdf-parse": "^1.1.4",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
